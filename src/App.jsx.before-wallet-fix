/* ============================================================
   APP
============================================================ */

export default function App() {
  const providers = useWalletProviders();

  const [walletModalOpen, setWalletModalOpen] =
    useState(false);

  const [connectedAddress, setConnectedAddress] =
    useState("");

  const [connectedProvider, setConnectedProvider] =
    useState(null);

  const [connecting, setConnecting] =
    useState(false);

  const [walletError, setWalletError] =
    useState("");

  /*
   * Check already-authorized wallets without prompting.
   */
  useEffect(() => {
    let cancelled = false;

    async function checkExistingConnection() {
      for (const item of providers) {
        try {
          const accounts = await item.provider.request({
            method: "eth_accounts",
          });

          if (
            Array.isArray(accounts) &&
            accounts.length > 0 &&
            !cancelled
          ) {
            setConnectedAddress(accounts[0]);
            setConnectedProvider(item);
            return;
          }
        } catch {
          // Ignore providers that reject eth_accounts.
        }
      }
    }

    if (providers.length > 0) {
      checkExistingConnection();
    }

    return () => {
      cancelled = true;
    };
  }, [providers]);

  /*
   * Lock page scrolling while wallet modal is open.
   */
  useEffect(() => {
    if (!walletModalOpen) {
      document.body.classList.remove(
        "wallet-modal-open"
      );

      return;
    }

    document.body.classList.add(
      "wallet-modal-open"
    );

    return () => {
      document.body.classList.remove(
        "wallet-modal-open"
      );
    };
  }, [walletModalOpen]);

  /*
   * ESC closes modal.
   */
  useEffect(() => {
    if (!walletModalOpen) return;

    const handleKeyDown = (event) => {
      if (event.key === "Escape") {
        setWalletModalOpen(false);
      }
    };

    window.addEventListener(
      "keydown",
      handleKeyDown
    );

    return () => {
      window.removeEventListener(
        "keydown",
        handleKeyDown
      );
    };
  }, [walletModalOpen]);

  const handleOpenWallet = () => {
    setWalletError("");
    setWalletModalOpen(true);
  };

  const handleConnect = async (item) => {
    if (!item?.provider) return;

    setConnecting(true);
    setWalletError("");

    try {
      const accounts = await item.provider.request({
        method: "eth_requestAccounts",
      });

      if (
        !Array.isArray(accounts) ||
        !accounts[0]
      ) {
        throw new Error(
          "No wallet account was returned."
        );
      }

      setConnectedAddress(accounts[0]);
      setConnectedProvider(item);

      setWalletModalOpen(false);
    } catch (error) {
      console.error(
        "AELVORA wallet connection failed:",
        error
      );

      if (
        error?.code === 4001
      ) {
        setWalletError(
          "Connection request was rejected in the wallet."
        );
      } else {
        setWalletError(
          error?.message ||
            "Unable to connect to this wallet."
        );
      }
    } finally {
      setConnecting(false);
    }
  };

  /*
   * Keep wallet state synchronized when user changes account.
   */
  useEffect(() => {
    if (!connectedProvider?.provider?.on) {
      return;
    }

    const provider =
      connectedProvider.provider;

    const handleAccountsChanged = (
      accounts
    ) => {
      if (
        Array.isArray(accounts) &&
        accounts.length > 0
      ) {
        setConnectedAddress(accounts[0]);
      } else {
        setConnectedAddress("");
        setConnectedProvider(null);
      }
    };

    provider.on(
      "accountsChanged",
      handleAccountsChanged
    );

    return () => {
      if (provider.removeListener) {
        provider.removeListener(
          "accountsChanged",
          handleAccountsChanged
        );
      }
    };
  }, [connectedProvider]);

  return (
    <div className="app-shell">
      <Navbar
        connectedAddress={connectedAddress}
        onConnect={handleOpenWallet}
      />

      <main>
        <Hero
          onConnect={handleOpenWallet}
        />

        <Launchpad />

        <Explore />

        <HowItWorks />

        <Fees />
      </main>

      <Footer />

      {walletModalOpen && (
        <WalletModal
          providers={providers}
          onClose={() =>
            setWalletModalOpen(false)
          }
          onConnect={handleConnect}
          connecting={connecting}
          error={walletError}
        />
      )}
    </div>
  );
}
