/* ============================================================
   HELPERS
============================================================ */

function shortAddress(address) {
  if (!address) return "";
  return `${address.slice(0, 6)}...${address.slice(-4)}`;
}

function walletKey(provider) {
  return (
    provider?.info?.rdns ||
    provider?.info?.uuid ||
    provider?.info?.name ||
    Math.random().toString()
  );
}

/* ============================================================
   WALLET DISCOVERY
   EIP-6963
============================================================ */

function useWalletProviders() {
  const [providers, setProviders] = useState([]);

  useEffect(() => {
    if (typeof window === "undefined") return;

    const discovered = new Map();

    const handleAnnouncement = (event) => {
      const detail = event?.detail;

      if (!detail?.info || !detail?.provider) return;

      const info = detail.info;

      const key =
        info.rdns ||
        info.uuid ||
        `${info.name}-${info.icon || ""}`;

      if (!discovered.has(key)) {
        discovered.set(key, detail);

        setProviders(Array.from(discovered.values()));
      }
    };

    window.addEventListener(
      "eip6963:announceProvider",
      handleAnnouncement
    );

    /*
     * Ask all installed EIP-6963 wallets to announce themselves.
     *
     * This does NOT call window.ethereum.
     * Therefore MetaMask/Rabby/OKX/etc can coexist.
     */
    window.dispatchEvent(
      new Event("eip6963:requestProvider")
    );

    return () => {
      window.removeEventListener(
        "eip6963:announceProvider",
        handleAnnouncement
      );
    };
  }, []);

  return providers;
}

