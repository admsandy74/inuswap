@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap");

:root {
  font-family: "DM Sans", Inter, system-ui, sans-serif;
  color: #f3fff9;
  background: #06100d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #06100d;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.site-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.background-layer {
  position: fixed;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  pointer-events: none;
}

.background-layer::after {
  content: "";
  position: absolute;
  inset: 0;

  opacity: 0.28;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px
    );

  background-size: 64px 64px;

  mask-image: linear-gradient(
    #000,
    transparent 80%
  );
}

.background-animated {
  animation:
    backgroundDrift 14s ease-in-out infinite
    alternate;
}

@keyframes backgroundDrift {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(1.035);
  }
}

/* ============================================================
   GLOBAL
============================================================ */

.navbar,
main,
footer {
  position: relative;
  z-index: 1;
}

.navbar {
  width: min(1360px, calc(100% - 64px));
  height: 96px;
  margin: auto;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  border-bottom: 1px solid
    rgba(125, 255, 215, 0.1);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  width: fit-content;
}

.brand-logo {
  width: 38px;
  height: 38px;
  object-fit: contain;
  display: block;
}

.brand-wordmark {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.brand-wordmark strong {
  font-size: 16px;
  line-height: 1;
  letter-spacing: 0.09em;
}

.brand-wordmark small {
  color: #70867c;
  font-size: 9px;
  line-height: 1;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 38px;
}

.nav-links a {
  color: #8da49a;
  font-size: 14px;

  transition:
    color 0.2s ease;
}

.nav-links a:hover {
  color: var(--text);
}

/* ============================================================
   NAVBAR ACTIONS
============================================================ */

.navbar-actions {
  justify-self: end;

  display: flex;
  align-items: center;
  gap: 9px;
}

/* ============================================================
   SOCIAL BUTTONS
============================================================ */

.social-button {
  position: relative;

  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border: 1px solid
    rgba(125, 255, 215, 0.16);

  border-radius: 10px;

  color: #91aaa0;

  background:
    linear-gradient(
      145deg,
      rgba(12, 31, 23, 0.72),
      rgba(6, 16, 13, 0.58)
    );

  overflow: hidden;

  transition:
    transform 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

/* animated shine */

.social-button::before {
  content: "";

  position: absolute;
  inset: -60%;

  background:
    linear-gradient(
      115deg,
      transparent 42%,
      rgba(125, 255, 215, 0.12) 50%,
      transparent 58%
    );

  transform:
    translateX(-70%)
    rotate(8deg);

  transition:
    transform 0.55s ease;

  pointer-events: none;
}

.social-button svg {
  position: relative;
  z-index: 2;

  width: 17px;
  height: 17px;

  fill: currentColor;

  transition:
    transform 0.25s ease,
    filter 0.25s ease;
}

/* ============================================================
   X BUTTON
============================================================ */

.social-x:hover {
  color: #ffffff;

  border-color:
    rgba(255, 255, 255, 0.3);

  background:
    linear-gradient(
      145deg,
      rgba(28, 34, 31, 0.9),
      rgba(7, 13, 11, 0.8)
    );

  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.25),
    0 0 22px rgba(255, 255, 255, 0.045);

  transform: translateY(-2px);
}

/* ============================================================
   TELEGRAM BUTTON
============================================================ */

.social-telegram:hover {
  color: var(--accent);

  border-color:
    rgba(125, 255, 215, 0.42);

  background:
    linear-gradient(
      145deg,
      rgba(11, 38, 28, 0.9),
      rgba(6, 18, 13, 0.8)
    );

  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.25),
    0 0 25px rgba(0, 211, 149, 0.13);

  transform: translateY(-2px);
}

/* shine */

.social-button:hover::before {
  transform:
    translateX(70%)
    rotate(8deg);
}

.social-button:hover svg {
  transform: scale(1.08);
}

/* click */

.social-x:active,
.social-telegram:active {
  transform: translateY(0) scale(0.96);
}

/* telegram idle pulse */

.social-telegram::after {
  content: "";

  position: absolute;
  inset: -1px;

  border-radius: inherit;

  border: 1px solid
    rgba(125, 255, 215, 0.15);

  opacity: 0;

  animation:
    telegramPulse 3.2s ease-in-out infinite;

  pointer-events: none;
}

@keyframes telegramPulse {
  0%,
  70%,
  100% {
    transform: scale(1);
    opacity: 0;
  }

  15% {
    transform: scale(1.08);
    opacity: 0.5;
  }

  35% {
    transform: scale(1.14);
    opacity: 0;
  }
}

/* ============================================================
   CONNECT WALLET
============================================================ */

.wallet-button {
  position: relative;
  overflow: hidden;

  padding: 13px 20px;

  color: var(--text);

  background:
    rgba(7, 20, 15, 0.5);

  border: 1px solid
    rgba(125, 255, 215, 0.22);

  border-radius: 10px;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.wallet-button::before {
  content: "";

  position: absolute;
  top: 0;
  left: -120%;

  width: 80%;
  height: 100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(125, 255, 215, 0.1),
      transparent
    );

  transform: skewX(-20deg);

  transition:
    left 0.55s ease;
}

.wallet-button:hover::before {
  left: 140%;
}

.wallet-button:hover {
  transform: translateY(-2px);

  border-color:
    rgba(125, 255, 215, 0.45);

  background:
    rgba(11, 30, 22, 0.7);

  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.2),
    0 0 20px rgba(0, 211, 149, 0.06);
}

/* ============================================================
   HERO
============================================================ */

.hero {
  width: min(1360px, calc(100% - 64px));
  min-height: 700px;
  margin: auto;

  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
}

.hero-copy {
  padding: 80px 0;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;

  color: var(--accent);

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--accent);

  box-shadow:
    0 0 10px var(--accent),
    0 0 24px rgba(0, 211, 149, 0.35);
}

.hero h1 {
  max-width: 720px;

  margin: 26px 0 24px;

  font-size:
    clamp(64px, 6.7vw, 104px);

  line-height: 0.93;

  letter-spacing: -0.065em;
}

.hero h1 span,
.cta-section h2 span {
  color: var(--accent-soft);
}

.hero p {
  max-width: 650px;

  color: var(--muted);

  font-size: 18px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 12px;

  margin-top: 30px;
}

.button {
  min-height: 54px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 21px;

  border-radius: 11px;

  border: 1px solid transparent;

  font-size: 14px;
  font-weight: 700;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: #03100b;
  background: var(--accent);
}

.button-primary:hover {
  box-shadow:
    0 12px 35px rgba(0, 211, 149, 0.15);
}

.button-secondary {
  color: var(--text);

  border-color:
    rgba(125, 255, 215, 0.2);

  background:
    rgba(7, 18, 14, 0.42);
}

.button-secondary:hover {
  border-color:
    rgba(125, 255, 215, 0.4);

  background:
    rgba(10, 28, 21, 0.7);
}

.arrow {
  margin-left: 11px;
  font-size: 17px;
}

.hero-note {
  margin-top: 70px;

  display: flex;

  gap: 15px;

  color: #657b71;

  font-size: 11px;

  letter-spacing: 0.09em;

  text-transform: uppercase;
}

.hero-note span {
  color: var(--accent);
}

/* ============================================================
   HERO MARKET MARK
============================================================ */

.hero-visual {
  min-height: 620px;

  position: relative;

  display: grid;
  place-items: center;
}

.market-mark {
  position: relative;

  width: 330px;
  height: 330px;

  display: grid;
  place-items: center;
}

.market-mark-large {
  width: min(540px, 94%);
  height: min(540px, 94%);
}

/* Orbit rings */

.mark-orbit {
  position: absolute;

  border: 1px solid
    rgba(0, 211, 149, 0.23);

  border-radius: 50%;

  inset: 8%;
}

.mark-orbit-a {
  transform:
    rotate(22deg)
    scaleY(0.48);

  animation:
    orbitA 4.2s linear infinite;
}

.mark-orbit-b {
  transform:
    rotate(-42deg)
    scaleY(0.52);

  animation:
    orbitB 5.2s linear infinite reverse;
}

.mark-orbit-c {
  inset: 21%;

  border-color:
    rgba(124, 255, 215, 0.3);

  animation:
    pulseOrbit 1.8s ease-in-out infinite;
}

@keyframes orbitA {
  from {
    transform:
      rotate(22deg)
      scaleY(0.48);
  }

  to {
    transform:
      rotate(382deg)
      scaleY(0.48);
  }
}

@keyframes orbitB {
  from {
    transform:
      rotate(-42deg)
      scaleY(0.52);
  }

  to {
    transform:
      rotate(318deg)
      scaleY(0.52);
  }
}

@keyframes pulseOrbit {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.55;
  }

  50% {
    transform: scale(1.1);
    opacity: 1;
  }
}

/* Core */

.mark-core {
  position: relative;
  z-index: 2;

  width: 116px;
  height: 116px;

  display: grid;
  place-items: center;

  border:
    1px solid
    rgba(124, 255, 215, 0.48);

  border-radius: 50%;

  background:
    rgba(3, 15, 11, 0.72);

  box-shadow:
    0 0 35px rgba(0, 211, 149, 0.12),
    inset 0 0 35px rgba(0, 211, 149, 0.05);

  animation:
    corePulse 2s ease-in-out infinite;
}

.market-mark-large .mark-core {
  width: 152px;
  height: 152px;
}

.mark-core img {
  width: 62%;
  height: 62%;

  object-fit: contain;

  filter:
    drop-shadow(
      0 0 12px
      rgba(124, 255, 215, 0.22)
    );
}

@keyframes corePulse {
  0%,
  100% {
    box-shadow:
      0 0 35px rgba(0, 211, 149, 0.12),
      inset 0 0 35px rgba(0, 211, 149, 0.05);
  }

  50% {
    box-shadow:
      0 0 75px rgba(0, 211, 149, 0.25),
      inset 0 0 45px rgba(0, 211, 149, 0.1);
  }
}

/* Orbit dots */

.mark-dot {
  position: absolute;
  z-index: 3;

  width: 9px;
  height: 9px;

  border-radius: 50%;

  background: var(--accent);

  box-shadow:
    0 0 12px var(--accent),
    0 0 25px rgba(0, 211, 149, 0.4);
}

.mark-dot-a {
  top: 11%;
  left: 15%;

  animation:
    dotFloatA 2.7s ease-in-out infinite;
}

.mark-dot-b {
  right: 8%;
  top: 43%;

  animation:
    dotFloatB 3.1s ease-in-out infinite;
}

.mark-dot-c {
  bottom: 11%;
  left: 31%;

  animation:
    dotFloatC 3.4s ease-in-out infinite;
}

@keyframes dotFloatA {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(14px, -18px);
  }
}

@keyframes dotFloatB {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-13px, 15px);
  }
}

@keyframes dotFloatC {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(12px, -14px);
  }
}

.visual-label {
  position: absolute;

  right: 3%;
  bottom: 11%;

  display: flex;
  flex-direction: column;

  gap: 7px;

  text-align: right;
}

.visual-label span {
  color: #647b71;

  font-size: 9px;

  letter-spacing: 0.18em;
}

.visual-label strong {
  color: var(--accent);

  font-size: 12px;

  letter-spacing: 0.1em;
}

/* ============================================================
   STATS
============================================================ */

.stats {
  width: min(1360px, calc(100% - 64px));

  margin: auto;

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  border-top:
    1px solid
    rgba(125, 255, 215, 0.12);

  border-bottom:
    1px solid
    rgba(125, 255, 215, 0.12);
}

.stats div {
  padding: 24px 30px;

  border-right:
    1px solid
    rgba(125, 255, 215, 0.1);
}

.stats div:last-child {
  border-right: 0;
}

.stats span {
  display: block;

  color: #647b71;

  font-size: 10px;

  letter-spacing: 0.13em;

  text-transform: uppercase;
}

.stats strong {
  display: block;

  margin-top: 8px;

  font-size: 20px;
}

/* ============================================================
   GENERAL SECTIONS
============================================================ */

.section,
.market-section,
.fee-section,
.cta-section {
  width: min(1360px, calc(100% - 64px));
  margin: auto;
}

.section {
  padding: 130px 0;
}

.section-heading {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 60px;

  align-items: end;
}

.section-kicker {
  color: var(--accent);

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 0.16em;
}

.section-heading h2,
.market-panel h2,
.fee-copy h2,
.cta-section h2 {
  margin: 18px 0 0;

  font-size:
    clamp(44px, 4.7vw, 70px);

  line-height: 0.98;

  letter-spacing: -0.055em;
}

.section-heading p,
.fee-copy p,
.market-copy p {
  max-width: 570px;

  color: var(--muted);

  font-size: 16px;

  line-height: 1.7;
}

/* ============================================================
   FEATURE CARDS
============================================================ */

.feature-grid {
  margin-top: 55px;

  display: grid;

  grid-template-columns:
    1.4fr 1fr 1fr;

  gap: 14px;
}

.feature-card {
  min-height: 330px;

  padding: 30px;

  border:
    1px solid
    rgba(125, 255, 215, 0.11);

  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(12, 31, 23, 0.8),
      rgba(6, 16, 13, 0.55)
    );

  transition:
    transform 0.25s ease,
    border-color 0.25s ease;
}

.feature-card:hover {
  transform: translateY(-5px);

  border-color:
    rgba(125, 255, 215, 0.25);
}

.card-number {
  color: var(--accent);

  font-size: 10px;

  letter-spacing: 0.14em;
}

.card-icon {
  margin-top: 56px;

  color: var(--accent-soft);

  font-size: 34px;
}

.feature-card h3 {
  margin: 22px 0 10px;

  font-size: 26px;
}

.feature-card p {
  color: var(--muted);

  line-height: 1.65;
}

.feature-card a {
  display: inline-flex;

  margin-top: 20px;

  color: var(--accent);

  font-size: 13px;

  font-weight: 700;
}

/* ============================================================
   MARKET / DISCOVERY
============================================================ */

.market-section {
  padding-bottom: 130px;
}

.market-panel {
  min-height: 460px;

  position: relative;

  overflow: hidden;

  padding: 72px 66px;

  border:
    1px solid
    rgba(125, 255, 215, 0.14);

  border-radius: 18px;

  background:
    linear-gradient(
      105deg,
      rgba(8, 25, 18, 0.94),
      rgba(8, 27, 19, 0.68)
    );
}

.market-copy {
  position: relative;
  z-index: 5;

  max-width: 550px;
}

.market-copy p {
  margin-top: 24px;
}

/* Discovery visual */

.discovery-visual {
  position: absolute;

  width: 52%;
  height: 82%;

  right: 2%;
  top: 9%;

  display: grid;
  place-items: center;
}

.discovery-glow {
  position: absolute;

  width: 260px;
  height: 260px;

  border-radius: 50%;

  background:
    rgba(0, 211, 149, 0.09);

  filter: blur(45px);

  animation:
    discoveryGlow 2.4s ease-in-out infinite;
}

@keyframes discoveryGlow {
  0%,
  100% {
    transform: scale(0.92);
    opacity: 0.55;
  }

  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

.discovery-ring {
  position: absolute;

  border:
    1px solid
    rgba(0, 211, 149, 0.22);

  border-radius: 50%;
}

.discovery-ring-a {
  width: 310px;
  height: 190px;

  transform: rotate(24deg);

  animation:
    discoveryRingA 3.6s linear infinite;
}

.discovery-ring-b {
  width: 250px;
  height: 250px;

  transform: rotate(-18deg);

  border-color:
    rgba(124, 255, 215, 0.16);

  animation:
    discoveryRingB 4.5s linear infinite reverse;
}

@keyframes discoveryRingA {
  from {
    transform: rotate(24deg);
  }

  to {
    transform: rotate(384deg);
  }
}

@keyframes discoveryRingB {
  from {
    transform: rotate(-18deg);
  }

  to {
    transform: rotate(342deg);
  }
}

.discovery-core {
  position: relative;
  z-index: 5;

  width: 110px;
  height: 110px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  border:
    1px solid
    rgba(124, 255, 215, 0.4);

  background:
    rgba(4, 18, 13, 0.9);

  box-shadow:
    0 0 55px rgba(0, 211, 149, 0.16),
    inset 0 0 30px rgba(0, 211, 149, 0.05);

  animation:
    discoveryCore 2s ease-in-out infinite;
}

.discovery-core img {
  width: 62px;
  height: 62px;

  object-fit: contain;

  filter:
    drop-shadow(
      0 0 12px
      rgba(124, 255, 215, 0.2)
    );
}

@keyframes discoveryCore {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.08);
  }
}

.discovery-node {
  position: absolute;
  z-index: 6;

  width: 62px;
  height: 62px;

  display: grid;
  place-items: center;

  border:
    1px solid
    rgba(125, 255, 215, 0.18);

  border-radius: 12px;

  color: var(--accent-soft);

  background:
    rgba(6, 21, 15, 0.86);

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.2);

  font-size: 23px;
}

.discovery-node-a {
  top: 18%;
  left: 18%;

  animation:
    discoveryNodeA 2.8s ease-in-out infinite;
}

.discovery-node-b {
  top: 13%;
  right: 17%;

  color: var(--accent);

  animation:
    discoveryNodeB 3.1s ease-in-out infinite;
}

.discovery-node-c {
  bottom: 16%;
  left: 23%;

  animation:
    discoveryNodeC 3.4s ease-in-out infinite;
}

.discovery-node-d {
  bottom: 13%;
  right: 22%;

  animation:
    discoveryNodeD 2.9s ease-in-out infinite;
}

@keyframes discoveryNodeA {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(9px, -12px);
  }
}

@keyframes discoveryNodeB {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-10px, 10px);
  }
}

@keyframes discoveryNodeC {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(10px, 9px);
  }
}

@keyframes discoveryNodeD {
  0%,
  100% {
    transform: translate(0, 0);
  }

  50% {
    transform: translate(-9px, -10px);
  }
}

.market-button {
  position: absolute;

  right: 62px;
  bottom: 60px;

  z-index: 8;
}

/* ============================================================
   PROCESS
============================================================ */

.process {
  position: relative;

  margin-top: 75px;

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 25px;
}

.process-line {
  position: absolute;

  left: 4%;
  right: 4%;
  top: 16px;

  height: 1px;

  background:
    rgba(125, 255, 215, 0.16);
}

.process-step {
  position: relative;
  z-index: 1;

  padding-right: 20px;
}

.process-step span {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  border:
    1px solid
    rgba(125, 255, 215, 0.25);

  background: var(--bg);

  color: var(--accent);

  font-size: 10px;
}

.process-step strong {
  display: block;

  margin-top: 28px;

  font-size: 18px;
}

.process-step p {
  color: var(--muted);

  line-height: 1.6;

  font-size: 14px;
}

/* ============================================================
   FEES
============================================================ */

.fee-section {
  padding: 110px 0 130px;

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 90px;

  align-items: center;
}

.fee-card {
  padding: 34px;

  border:
    1px solid
    rgba(125, 255, 215, 0.14);

  border-radius: 16px;

  background:
    rgba(8, 24, 18, 0.75);
}

.fee-row {
  display: flex;

  justify-content: space-between;

  gap: 20px;

  padding: 16px 0;

  color: var(--muted);
}

.fee-row strong {
  color: var(--text);
}

.fee-divider {
  height: 1px;

  margin: 10px 0;

  background:
    rgba(125, 255, 215, 0.12);
}

.fee-row.total strong {
  color: var(--accent);
}

.fee-footnote {
  margin: 22px 0 0;

  color: #71877e;

  font-size: 12px;

  line-height: 1.6;
}

/* ============================================================
   CTA
============================================================ */

.cta-section {
  position: relative;

  overflow: hidden;

  text-align: center;

  padding: 150px 30px;

  border-top:
    1px solid
    rgba(125, 255, 215, 0.1);
}

.cta-section > .market-mark {
  position: absolute;

  width: 470px;
  height: 470px;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -52%);

  opacity: 0.12;

  pointer-events: none;
}

.cta-section .section-kicker,
.cta-section h2,
.cta-section .hero-actions {
  position: relative;
  z-index: 3;
}

.cta-section h2 {
  margin: 22px auto 0;

  max-width: 760px;
}

.cta-section .hero-actions {
  justify-content: center;
}

/* ============================================================
   FOOTER
============================================================ */

footer {
  width: min(1360px, calc(100% - 64px));

  margin: auto;

  padding: 35px 0 50px;

  display: grid;

  grid-template-columns:
    1fr auto 1fr;

  align-items: center;

  border-top:
    1px solid
    rgba(125, 255, 215, 0.1);
}

.footer-links {
  display: flex;

  gap: 22px;

  flex-wrap: wrap;
}

.footer-links a {
  color: #71877e;

  font-size: 12px;

  transition:
    color 0.2s ease;
}

.footer-links a:hover {
  color: var(--text);
}

.copyright {
  justify-self: end;

  color: #586d64;

  font-size: 11px;
}

/* ============================================================
   TABLET
============================================================ */

@media (max-width: 900px) {
  .navbar,
  .hero,
  .section,
  .market-section,
  .fee-section,
  footer,
  .stats {
    width:
      min(
        calc(100% - 32px),
        680px
      );
  }

  .navbar {
    height: 78px;

    grid-template-columns:
      1fr auto;
  }

  .nav-links {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;

    min-height: auto;
  }

  .hero-copy {
    padding: 72px 0 25px;
  }

  .hero h1 {
    font-size:
      clamp(55px, 15vw, 80px);
  }

  .hero p {
    font-size: 16px;
  }

  .hero-visual {
    min-height: 470px;
  }

  .market-mark-large {
    width: 430px;
    height: 430px;
  }

  .stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .stats div:nth-child(2) {
    border-right: 0;
  }

  .stats div:nth-child(-n + 2) {
    border-bottom:
      1px solid
      rgba(125, 255, 215, 0.1);
  }

  .section {
    padding: 90px 0;
  }

  .section-heading,
  .fee-section {
    grid-template-columns: 1fr;

    gap: 20px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: 280px;
  }

  .market-panel {
    min-height: 640px;

    padding: 45px 28px;
  }

  .discovery-visual {
    width: 100%;
    height: 48%;

    right: 0;
    top: 38%;
  }

  .market-button {
    left: 28px;
    right: auto;
    bottom: 30px;
  }

  .process {
    grid-template-columns: 1fr;

    gap: 32px;
  }

  .process-line {
    left: 16px;
    top: 18px;
    bottom: 18px;

    width: 1px;
    height: auto;

    right: auto;
  }

  .process-step {
    padding-left: 55px;
  }

  .process-step strong {
    margin-top: -29px;
    margin-left: 48px;
  }

  .process-step p {
    margin-left: 48px;
  }

  .fee-section {
    padding: 80px 0 90px;
  }

  footer {
    grid-template-columns: 1fr;

    gap: 25px;
  }

  .copyright {
    justify-self: start;
  }
}

/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 520px) {
  .navbar,
  .hero,
  .section,
  .market-section,
  .fee-section,
  footer,
  .stats {
    width: calc(100% - 24px);
  }

  .brand-logo {
    width: 34px;
    height: 34px;
  }

  .brand-wordmark strong {
    font-size: 15px;
  }

  /* mobile navbar actions */

  .navbar-actions {
    gap: 6px;
  }

  .social-button {
    width: 38px;
    height: 38px;
  }

  .social-button svg {
    width: 15px;
    height: 15px;
  }

  .wallet-button {
    padding: 10px 12px;
    font-size: 12px;
  }

  .hero h1 {
    font-size: 53px;
  }

  .hero-note {
    margin-top: 48px;
  }

  .hero-visual {
    min-height: 390px;
  }

  .market-mark-large {
    width: 330px;
    height: 330px;
  }

  .market-panel {
    min-height: 590px;
  }

  .discovery-visual {
    top: 41%;
    height: 45%;
  }

  .discovery-ring-a {
    width: 240px;
    height: 150px;
  }

  .discovery-ring-b {
    width: 190px;
    height: 190px;
  }

  .discovery-core {
    width: 82px;
    height: 82px;
  }

  .discovery-core img {
    width: 46px;
    height: 46px;
  }

  .discovery-node {
    width: 46px;
    height: 46px;

    border-radius: 9px;

    font-size: 18px;
  }

  .stats div {
    padding: 18px 15px;
  }

  .cta-section {
    padding: 110px 20px;
  }

  .cta-section > .market-mark {
    width: 330px;
    height: 330px;
  }
}

/* ============================================================
   REDUCED MOTION
============================================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;

    animation-iteration-count: 1 !important;

    scroll-behavior: auto !important;
  }
}
