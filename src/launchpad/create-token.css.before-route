.create-token-page {
  min-height: 100vh;
  color: var(--text);
  background: var(--bg);
  position: relative;
  z-index: 10;
}

.create-token-nav {
  height: 76px;
  padding: 0 5vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--border);
  background: rgba(6, 16, 13, 0.86);
  backdrop-filter: blur(18px);
}

.create-token-back,
.create-token-wallet {
  border: 1px solid var(--border);
  border-radius: 9px;
  background: rgba(12, 31, 23, 0.7);
  color: var(--text);
  cursor: pointer;
}

.create-token-back {
  padding: 10px 14px;
}

.create-token-nav-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.create-token-balance,
.create-token-network {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .06em;
  white-space: nowrap;
}

.create-token-network {
  padding: 9px 11px;
  border: 1px solid rgba(125, 255, 215, .18);
  border-radius: 8px;
}

.create-token-wallet {
  padding: 10px 14px;
  font-weight: 800;
}

.create-token-main {
  width: min(900px, calc(100% - 32px));
  margin: 0 auto;
  padding: 72px 0 100px;
}

.create-token-heading {
  margin-bottom: 32px;
}

.create-token-heading > span,
.create-token-kicker {
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .14em;
  color: var(--accent);
}

.create-token-heading h1 {
  margin: 10px 0;
  font-size: clamp(38px, 6vw, 64px);
  letter-spacing: -.045em;
}

.create-token-heading p {
  max-width: 560px;
  color: var(--text-soft);
  line-height: 1.7;
}

.create-token-card {
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background:
    linear-gradient(
      145deg,
      rgba(12, 31, 23, .72),
      rgba(6, 16, 13, .78)
    );
  box-shadow: 0 24px 80px rgba(0, 0, 0, .22);
}

.create-token-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.create-token-card-header h2 {
  margin: 7px 0 0;
  font-size: 25px;
}

.create-token-chain {
  padding: 8px 10px;
  border: 1px solid rgba(125, 255, 215, .18);
  border-radius: 7px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.create-token-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.create-token-field,
.create-token-grid label {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.create-token-field {
  margin-top: 16px;
}

.create-token-grid label > span,
.create-token-field > span {
  font-size: 10px;
  font-weight: 800;
  color: var(--text-soft);
  letter-spacing: .05em;
}

.create-token-card input,
.create-token-card textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 13px 14px;

  border: 1px solid var(--border);
  border-radius: 9px;

  background: rgba(3, 10, 8, .55);
  color: var(--text);

  outline: none;
  font: inherit;
}

.create-token-card input:focus,
.create-token-card textarea:focus {
  border-color: rgba(125, 255, 215, .45);
}

.create-token-card textarea {
  resize: vertical;
}

.create-token-input-unit {
  position: relative;
}

.create-token-input-unit input {
  padding-right: 58px;
}

.create-token-input-unit strong {
  position: absolute;
  right: 13px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 10px;
}

.create-token-fees {
  margin-top: 22px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.create-token-fee {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.create-token-fee + .create-token-fee {
  border-top: 1px solid var(--border);
}

.create-token-fee strong {
  display: block;
  font-size: 12px;
}

.create-token-fee small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.create-token-percent {
  display: flex;
  align-items: center;
  gap: 5px;
}

.create-token-percent input {
  width: 65px;
  padding: 9px;
  text-align: right;
}

.create-token-percent span {
  font-size: 11px;
  font-weight: 800;
}

.create-token-fixed {
  color: var(--accent);
}

.create-token-summary {
  margin-top: 18px;
  padding: 14px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-radius: 9px;
  background: rgba(125, 255, 215, .045);
}

.create-token-summary span {
  color: var(--text-soft);
  font-size: 10px;
}

.create-token-summary strong {
  font-size: 10px;
}

.create-token-submit {
  width: 100%;
  margin-top: 22px;
  padding: 16px;

  border: 1px solid rgba(125, 255, 215, .3);
  border-radius: 10px;

  color: #06100d;
  background: var(--accent);

  font-weight: 900;
  letter-spacing: .08em;
  cursor: pointer;
}

.create-token-submit span {
  margin-left: 8px;
}

.create-token-note {
  margin: 13px 0 0;
  text-align: center;
  color: var(--muted);
  font-size: 9px;
}

@media (max-width: 700px) {
  .create-token-nav {
    padding: 0 16px;
  }

  .create-token-nav-right {
    gap: 6px;
  }

  .create-token-network {
    display: none;
  }

  .create-token-main {
    padding-top: 45px;
  }

  .create-token-card {
    padding: 20px;
  }

  .create-token-grid {
    grid-template-columns: 1fr;
  }

  .create-token-card-header {
    flex-direction: column;
  }

  .create-token-summary {
    flex-direction: column;
  }
}
