              {item.label}
            </a>
          ))}

          {social.x && (
            <a
              href={social.x}
              target="_blank"
              rel="noopener noreferrer"
            >
              X
            </a>
          )}

          {social.telegram && (
            <a
              href={social.telegram}
              target="_blank"
              rel="noopener noreferrer"
            >
              Telegram
            </a>
          )}

          {social.discord && (
            <a
              href={social.discord}
              target="_blank"
              rel="noopener noreferrer"
            >
              Discord
            </a>
          )}

          {links.docs && (
            <a
              href={links.docs}
              target="_blank"
              rel="noopener noreferrer"
            >
              Docs
            </a>
          )}
        </div>

        <span className="copyright">
          {footer.copyright}
        </span>
      </footer>

      {walletOpen && (
        <WalletModal
          onClose={() => setWalletOpen(false)}
          onConnected={(address, provider, chainId) => {
            setWalletAddress(address);
            setWalletChainId(chainId);
          }}
          onDisconnected={() => {
            setWalletAddress(null);
            setWalletChainId(null);
            setWalletBalance(null);
          }}
          />
      )}
    </div>
    </>
  );
}
