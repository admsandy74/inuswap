import { useEffect, useState } from "react";
import { SITE_CONFIG } from "./config/site";
import WalletModal from "./wallet/WalletModal";
import CreateToken from "./launchpad/CreateToken";
import MarketPage from "./market/MarketPage";
import SwapPage from "./swap/SwapPage";
import {
  getWalletChainId,
  getWalletBalance,
  switchToRobinhoodChain,
  disconnectWallet,
  ROBINHOOD_CHAIN_ID,
  getActiveWalletProvider,
  setActiveWalletProvider,
  clearActiveWalletProvider,
  discoverInjectedWallets,
  getInjectedWallets,
} from "./wallet/wallet";
import "./index.css";

const {
  brand,
  navigation,
  hero,
  platform,
  launchpad,
  fees,
  social,
  links,
  cta,
  theme,
  background,
  footer,
} = SITE_CONFIG;

function Logo() {
  return (
    <a className="brand" href="/" aria-label={brand.fullName}>
      <img
        src={brand.logo.icon}
        alt=""
        className="brand-logo"
      />

      <span className="brand-wordmark">
        <strong>{brand.name}</strong>
        <small>{brand.product}</small>
      </span>
