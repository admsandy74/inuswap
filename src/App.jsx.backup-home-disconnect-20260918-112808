function AelvoraStaticNav() {
  const items = [
    {
      label: "Home",
      href: "/",
      icon: "⌂",
    },
    {
      label: "Creator",
      href: "/create",
      icon: "✦",
    },
    {
      label: "Market",
      href: "/market",
      icon: "◈",
    },
    {
      label: "Trade",
      href: "/swap",
      icon: "⇄",
    },
  ];

  const currentPath = window.location.pathname;

  return (
    <nav
      className="aelvora-static-nav"
      aria-label="AELVORA navigation"
    >
      {items.map((item) => {
        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath === item.href ||
              currentPath.startsWith(`${item.href}/`);

        return (
          <a
            key={item.href}
            href={item.href}
            className={active ? "active" : ""}
            aria-label={item.label}
          >
            <span className="aelvora-static-nav-icon">
              {item.icon}
            </span>
            <span className="aelvora-static-nav-label">
              {item.label}
            </span>
          </a>
        );
      })}
    </nav>
  );
}

export default function App() {
  const [walletOpen, setWalletOpen] = useState(false);
  const [walletAddress, setWalletAddress] = useState(null);

  const [walletChainId, setWalletChainId] = useState(null);
  const [walletBalance, setWalletBalance] = useState(null);
  const [switchingChain, setSwitchingChain] = useState(false);

  const [currentPage, setCurrentPage] = useState(
    window.location.pathname
  );

  const refreshWalletBalance = async (
    provider = getActiveWalletProvider(),
    address = walletAddress
  ) => {
    if (!provider || !address) {
      setWalletBalance(null);
      return;
    }

    const balance = await getWalletBalance(
      provider,
      address
    );

    setWalletBalance(balance);
  };

  useEffect(() => {
    let cancelled = false;

    async function restoreWalletSession() {
      try {
        discoverInjectedWallets();

        const tryRestore = async () => {
          if (cancelled || walletAddress) {
            return;
          }

          const wallets = getInjectedWallets();

          for (const wallet of wallets) {
            if (cancelled) {
              return;
            }

            const provider = wallet?.provider;

            if (!provider) {
              continue;
            }

            try {
              const accounts = await provider.request({
                method: "eth_accounts",
              });

              const address = accounts?.[0] ?? null;

              if (!address) {
                continue;
              }

              const chainId = await getWalletChainId(provider);

              if (cancelled) {
                return;
              }

              setActiveWalletProvider(provider);
              setWalletAddress(address);
              setWalletChainId(chainId);

              return;
            } catch {
              // Ignore providers that do not expose an active account.
            }
          }
        };

        await tryRestore();

        if (!cancelled && !walletAddress) {
          setTimeout(() => {
            tryRestore();
          }, 250);
        }
      } catch (error) {
        console.warn(
          "[AELVORA] Wallet session restore failed:",
          error?.message || error
        );
      }
    }

    restoreWalletSession();

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    refreshWalletBalance();
  }, [walletAddress, walletChainId]);

  const handleWalletDisconnect = () => {
    // Disconnect hanya dari session AELVORA.
    // Jangan menunggu / memaksa injected wallet provider.
    // UI harus langsung kembali ke keadaan disconnected.
    clearActiveWalletProvider();

    setWalletAddress(null);
    setWalletChainId(null);
    setWalletBalance(null);
    setWalletOpen(false);
    setSwitchingChain(false);

    console.log("[AELVORA] Wallet session disconnected.");
  };

  useEffect(() => {
    const handlePopState = () => {
      setCurrentPage(window.location.pathname);
    };

    window.addEventListener("popstate", handlePopState);

    return () => {
      window.removeEventListener("popstate", handlePopState);
    };
  }, []);


  // Aelvora Market page.
    // Aelvora Market page.
  if (currentPage === "/market") {
    return (
      <>
        <AelvoraStaticNav />
        <MarketPage
          onBack={() => {
            window.history.pushState({}, "", "/");
            window.dispatchEvent(
              new PopStateEvent("popstate")
            );
          }}
        />
      </>
    );
  }

  // Aelvora Swap page.
  if (
    currentPage === "/swap" ||
    currentPage.startsWith("/swap/")
  ) {
    return (
      <>
        <AelvoraStaticNav />
        <SwapPage
          walletAddress={walletAddress}
          walletChainId={walletChainId}
          onConnect={() => setWalletOpen(true)}
          onDisconnect={handleWalletDisconnect}
          onBack={() => {
            window.history.pushState({}, "", "/");
            window.dispatchEvent(
              new PopStateEvent("popstate")
            );
          }}
        />

        {walletOpen && (
          <WalletModal
            onClose={() => setWalletOpen(false)}
            onConnected={(address, provider, chainId) => {
              setWalletAddress(address);
              setWalletChainId(chainId);
              setWalletOpen(false);
            }}
            onDisconnected={() => {
              setWalletAddress(null);
              setWalletChainId(null);
              setWalletBalance(null);
              setWalletOpen(false);
            }}
          />
        )}
      </>
    );
  }

  // Launchpad Create Token page.
  // Continue using the wallet state/provider from the homepage.
  if (currentPage === "/create") {
    return (
      <>
        <AelvoraStaticNav />
        <CreateToken
          walletAddress={walletAddress}
          walletChainId={walletChainId}
          walletBalance={walletBalance}
          onConnect={() => setWalletOpen(true)}
          onDisconnect={handleWalletDisconnect}
          onBack={() => {
            window.history.pushState({}, "", "/");
            window.dispatchEvent(
              new PopStateEvent("popstate")
            );
          }}
        />

        {walletOpen && (
          <WalletModal
            onClose={() => setWalletOpen(false)}
            onConnected={(address, provider, chainId) => {
              setWalletAddress(address);
              setWalletChainId(chainId);
              setWalletOpen(false);
            }}
            onDisconnected={() => {
              setWalletAddress(null);
              setWalletChainId(null);
              setWalletBalance(null);
              setWalletOpen(false);
            }}
          />
        )}
      </>
    );
  }

  return (
    <>
      <AelvoraStaticNav />

      <div
        className="site-shell"
      style={{
        "--accent": theme.accent,
        "--accent-soft": theme.accentSoft,
        "--bg": theme.background,
        "--bg-alt": theme.backgroundAlt,
        "--surface": theme.surface,
        "--surface-alt": theme.surfaceAlt,
        "--border": theme.border,
        "--text": theme.text,
        "--text-soft": theme.textSoft,
        "--muted": theme.muted,
      }}
    >
      {/* BACKGROUND */}
      <div
        className={`background-layer ${
          background.animated
            ? "background-animated"
            : ""
        }`}
        style={{
          backgroundImage: background.image
            ? `linear-gradient(
                rgba(6,16,13,.72),
                rgba(6,16,13,.72)
              ), url(${background.image})`
            : background.gradient,
        }}
      />

      {/* NAVBAR */}
      <header className="navbar">
        <Logo />

        <nav className="nav-links">
          {(navigation ?? []).map((item) => (
            <a key={item.label} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>

        {/* SOCIAL + CONNECT WALLET */}
        <div className="navbar-actions">
          {social.x && (
            <a
              className="social-button social-x"
              href={social.x}
              target="_blank"
              rel="noreferrer"
              aria-label="AELVORA on X"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.967 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
              </svg>
            </a>
          )}

          {social.telegram && (
            <a
              className="social-button social-telegram"
              href={social.telegram}
              target="_blank"
              rel="noreferrer"
              aria-label="AELVORA on Telegram"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M21.7 3.3 2.9 10.55c-1.28.51-1.27 1.22-.23 1.54l4.82 1.5 1.85 5.62c.23.64.12.9.8.9.53 0 .76-.24 1.05-.52l2.33-2.26 4.84 3.57c.89.49 1.53.24 1.75-.83l3.15-14.86c.32-1.33-.51-1.94-1.56-1.41ZM8.23 13.25l10.95-6.91c.55-.34 1.06-.16.64.21l-8.91 8.04-.35 3.76-2.33-5.1Z" />
              </svg>
            </a>
          )}

            {walletAddress && (
              <button
                type="button"
                className={`chain-status ${
                  walletChainId === ROBINHOOD_CHAIN_ID
                    ? "chain-status-ok"
                    : "chain-status-wrong"
                }`}
                title={
                  walletChainId === ROBINHOOD_CHAIN_ID
                    ? "Connected to Robinhood Chain"
                    : "Switch to Robinhood Chain"
                }
                disabled={
                  switchingChain ||
                  walletChainId === ROBINHOOD_CHAIN_ID
                }
                onClick={async () => {
                  const provider = getActiveWalletProvider();

                  if (
                    !provider ||
                    walletChainId === ROBINHOOD_CHAIN_ID ||
                    switchingChain
                  ) {
                    return;
                  }

                  try {
                    setSwitchingChain(true);

                    const chainId =
                      await switchToRobinhoodChain(
                        provider
                      );

                    setWalletChainId(chainId);
                    await refreshWalletBalance(
                      provider,
                      walletAddress
                    );
                  } catch (err) {
                    console.error(
                      "Failed to switch network:",
                      err
                    );
                  } finally {
                    setSwitchingChain(false);
                  }
                }}
              >
                <span className="chain-status-dot" />
                {switchingChain
                  ? "SWITCHING..."
                  : walletChainId === ROBINHOOD_CHAIN_ID
                    ? "ROBINHOOD"
                    : "WRONG NETWORK"}
              </button>
            )}

          {walletAddress && walletBalance !== null && (
            <div className="wallet-balance" title="Wallet balance">
              {walletBalance} ETH
            </div>
          )}

          {cta.connectWallet.enabled && (
            walletAddress ? (
              <div className="wallet-actions">
                <button
                  type="button"
                  className="wallet-button wallet-address-button"
                  onClick={() => setWalletOpen(true)}
                  title="Wallet connected"
                >
                  {walletAddress.slice(0, 6)}...
                  {walletAddress.slice(-4)}
                </button>

                <button
                  type="button"
                  className="wallet-disconnect-button"
                  onClick={(event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    console.log("[AELVORA] DISCONNECT BUTTON CLICKED");

                    setWalletAddress(null);
                    setWalletChainId(null);
                    setWalletBalance(null);
                    setWalletOpen(false);
                    clearActiveWalletProvider();
                  }}
                  onPointerDown={(event) => {
                    event.stopPropagation();
                  }}
                >
                  Disconnect
                </button>
              </div>
            ) : (
              <button
                type="button"
                className="wallet-button"
                onClick={() => setWalletOpen(true)}
              >
                {cta.connectWallet.label}
              </button>
            )
          )}
        </div>
      </header>

      <main>
        {/* =====================================================
            HERO
        ====================================================== */}
        <section className="hero" id="top">
          <div className="hero-copy">
            <div className="eyebrow">
              <span className="status-dot" />
              {hero.eyebrow}
            </div>

            <h1>
              {hero.title}
              <br />
              <span>{hero.highlight}</span>
            </h1>

            <p>{hero.description}</p>

            <div className="hero-actions">
              {cta.launch.enabled && (
                <a
                  className="button button-primary"
                  href={cta.launch.href}
                >
                  {cta.launch.label}
                  <Arrow />
                </a>
              )}

              {cta.explore.enabled && (
                <a
                  className="button button-secondary"
                  href="#explore"
                >
                  {cta.explore.label}
                </a>
              )}
            </div>

            <div className="hero-note">
              <span>01</span>
              Built around transparent on-chain mechanics.
            </div>
          </div>

          <div className="hero-visual">
            <MarketMark large />

            <div className="visual-label">
              <span>{hero.status.label}</span>
              <strong>{hero.status.value}</strong>
            </div>
          </div>
        </section>

        {/* =====================================================
            STATS
        ====================================================== */}
        <section className="stats">
          <div>
            <span>Protocol Fee</span>
            <strong>{fees.protocol.default}%</strong>
          </div>

          <div>
            <span>Creator Fee</span>
            <strong>
              {fees.creator.minimum}–
              {fees.creator.maximum}%
            </strong>
          </div>

          <div>
            <span>Settlement</span>
            <strong>ETH Robinhood</strong>
          </div>

          <div>
            <span>Liquidity</span>
            <strong>
              {launchpad.liquidity.mechanism}
            </strong>
          </div>
        </section>

        {/* =====================================================
            LAUNCHPAD
        ====================================================== */}
        <section
          className="section"
          id="launchpad"
        >
          <div className="section-heading">
            <div>
              <span className="section-kicker">
                01 / LAUNCHPAD
              </span>

              <h2>{launchpad.title}</h2>
            </div>

            <p>{launchpad.description}</p>
          </div>

          <div className="feature-grid">
            {(platform.features ?? []).map(
              (feature, index) => (
                <article
                  className={`feature-card ${
                    index === 0
                      ? "feature-large"
                      : ""
                  }`}
                  key={feature.number}
                >
                  <span className="card-number">
                    {feature.number}
                  </span>

                  <div className="card-icon">
                    {index === 0
                      ? "◇"
                      : index === 1
                      ? "↗"
                      : "△"}
                  </div>

                  <h3>{feature.title}</h3>

                  <p>{feature.description}</p>

                  {index === 0 && (
                    <button
                      type="button"
                      className="launchpad-create-button"
                      onClick={() => {
                        window.history.pushState(
                          {},
                          "",
                          "/create"
                        );

                        window.dispatchEvent(
                          new PopStateEvent("popstate")
                        );
                      }}
                    >
                      {launchpad.cta}
                      <Arrow />
                    </button>
                  )}
                </article>
              )
            )}
          </div>
        </section>

        {/* =====================================================
            MARKET / EXPLORE
        ====================================================== */}
        <section
          className="market-section"
          id="explore"
        >
          <div className="market-panel">
            <div className="market-copy">
              <span className="section-kicker">
                {brand.fullName.toUpperCase()}
              </span>

              <h2>
                Discover what is
                <br />
                moving next
              </h2>

              <p>
                Explore emerging tokens launched
                through the{" "}
                {brand.fullName} ecosystem.
              </p>
            </div>

            <DiscoveryVisual />

            <button
              type="button"
              className="button button-secondary market-button"
              onClick={() => {
                window.history.pushState({}, "", "/market");

                window.dispatchEvent(
                  new PopStateEvent("popstate")
                );
              }}
            >
              {cta.explore.label}
              <Arrow />
            </button>
          </div>
        </section>

        {/* =====================================================
            HOW IT WORKS
        ====================================================== */}
        <section
          className="section process-section"
          id="how-it-works"
        >
          <div className="section-heading">
            <div>
              <span className="section-kicker">
                02 / MECHANICS
              </span>

              <h2>
                A simple path
                <br />
                Clear rules
              </h2>
            </div>

            <p>
              Every launch follows the same core
              lifecycle, making the market easier to
