function MiniChart({
  tokenAddress,
  pairAddress,
}) {
  const token = String(
    tokenAddress || ""
  ).trim();

  const pair = String(
    pairAddress || ""
  ).trim();

  if (!token) {
    return (
      <div className="swap-chart-empty">
        Select a token to view the chart.
      </div>
    );
  }

  const validAddress = (value) =>
    /^0x[a-fA-F0-9]{40}$/.test(value);

  const target =
    validAddress(pair)
      ? pair
      : token;

  const chartUrl =
    `https://dexscreener.com/robinhood/${target}` +
    `?chartType=price&embed=1&info=0&theme=dark&trades=0`;

  return (
    <iframe
      key={chartUrl}
      className="swap-chart-dex"
      src={chartUrl}
      title="DexScreener Chart"
      loading="eager"
      frameBorder="0"
      allow="clipboard-write"
    />
  );
}


function Pagination({ page, totalPages, onChange }) {
  if (totalPages <= 1) return null;

  return (
    <div className="swap-pagination">
      <button
        type="button"
        disabled={page === 1}
        onClick={() => onChange(page - 1)}
      >
        ←
      </button>

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((item) => (
        <button
          type="button"
          key={item}
          className={page === item ? "active" : ""}
          onClick={() => onChange(item)}
        >
          {item}
        </button>
      ))}

      <button
        type="button"
        disabled={page === totalPages}
        onClick={() => onChange(page + 1)}
      >
        →
      </button>
    </div>
  );
}

export default function SwapPage({
