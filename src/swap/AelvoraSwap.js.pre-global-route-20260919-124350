export async function getV4BuyQuote(tokenAddress, ethGross) {
  const gross = BigInt(ethGross);

  if (gross <= 0n) {
    throw new Error("Invalid ETH amount.");
  }

  const routerFee = calculateV4RouterFee(gross);
  const amountInToV4 = gross - routerFee;

  if (amountInToV4 <= 0n) {
    throw new Error("ETH amount is too small.");
  }

  const poolKey = buildV4PoolKey(tokenAddress);

  const result = await publicClient.simulateContract({
    address: V4_QUOTER,
    abi: QUOTER_ABI,
    functionName: "quoteExactInputSingle",
    args: [
      poolKey,
      true,
      amountInToV4,
      "0x",
    ],
  });

  const amountOut = result.result?.[0] ?? result.result;

  return {
    amountOut,
    routerFee,
    amountInToV4,
    gasEstimate: result.result?.[1] ?? 0n,
    minimumReceived: calculateMinimumReceived(amountOut),
  };
}

