async function getOnchainEthUsdPrice() {
  const [slot0, token0, token1] =
    await Promise.all([
      publicClient.readContract({
        address: ETH_USD_POOL,
        abi: ETH_USD_POOL_ABI,
        functionName: "slot0",
      }),
      publicClient.readContract({
        address: ETH_USD_POOL,
        abi: ETH_USD_POOL_ABI,
        functionName: "token0",
      }),
      publicClient.readContract({
        address: ETH_USD_POOL,
        abi: ETH_USD_POOL_ABI,
        functionName: "token1",
      }),
    ]);

  const [decimals0, decimals1] =
    await Promise.all([
      publicClient.readContract({
        address: token0,
        abi: ETH_USD_TOKEN_ABI,
        functionName: "decimals",
      }),
      publicClient.readContract({
        address: token1,
        abi: ETH_USD_TOKEN_ABI,
        functionName: "decimals",
      }),
    ]);

  const sqrtPriceX96 = BigInt(slot0[0]);

  const rawPrice =
    Number(sqrtPriceX96) *
    Number(sqrtPriceX96) /
    (2 ** 192);

  const adjustedPrice =
    rawPrice *
    (10 ** (Number(decimals0) - Number(decimals1)));

  const weth = ETH_USD_WETH.toLowerCase();
  const t0 = String(token0).toLowerCase();
  const t1 = String(token1).toLowerCase();

  if (t0 === weth) {
    return adjustedPrice;
  }

  if (t1 === weth) {
    return 1 / adjustedPrice;
  }

  throw new Error(
    "ETH/USD pool does not contain configured WETH."
  );
}


