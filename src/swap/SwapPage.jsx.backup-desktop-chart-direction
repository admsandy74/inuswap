    const source = Array.isArray(chartData)
      ? chartData
          .filter(
            (item) =>
              Number.isFinite(Number(item?.price)) &&
              Number(item.price) > 0 &&
              Number.isFinite(Number(item?.timestamp))
          )
          .sort(
            (a, b) =>
              Number(a.timestamp) -
              Number(b.timestamp)
          )
      : [];

    if (!source.length) {
      return [];
    }

    // AELVORA bonding curve:
    // show the full history from creation to current price.
    // Global V3/V4 charts keep their existing timeframe filter.
    if (
      tokenData?.isAelvora &&
      !tokenData?.isGraduated
    ) {
      return source;
    }

    const timeframeSeconds = {
      "5m": 5 * 60,
      "15m": 15 * 60,
      "1H": 60 * 60,
      "4H": 4 * 60 * 60,
      "1D": 24 * 60 * 60,
    };

    const seconds =
      timeframeSeconds[chartTimeframe] ||
      timeframeSeconds["1H"];

    const latestTimestamp = Number(
      source[source.length - 1].timestamp
    );

    const cutoff =
      latestTimestamp - seconds;

    const filtered = source.filter(
      (item) =>
        Number(item.timestamp) >= cutoff
    );

    if (!filtered.length) {
      return [source[source.length - 1]];
    }

    return filtered;
  }, [chartData, chartTimeframe]);

