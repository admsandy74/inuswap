function AelvoraCurveChart({
  data,
  ethReserve = 0n,
}) {
  const points = Array.isArray(data)
    ? [...data]
        .filter(
          (item) =>
            Number.isFinite(Number(item?.price)) &&
            Number(item.price) > 0 &&
            Number.isFinite(Number(item?.timestamp))
        )
        .sort(
          (a, b) =>
            Number(a.timestamp) -
            Number(b.timestamp)
        )
    : [];

  if (!points.length) {
    return (
      <div className="swap-chart-empty">
        Bonding curve data is loading...
      </div>
    );
  }

  const width = 1000;
  const height = 320;
  const padding = {
    top: 24,
    right: 4,
    bottom: 32,
    left: 68,
  };

  const chartWidth = width - padding.left - padding.right;

  const desktopPlotWidth =
    typeof window !== "undefined" && window.innerWidth > 900
      ? chartWidth * 0.78
      : chartWidth;

  const chartHeight =
    height - padding.top - padding.bottom;

  // Mobile currently renders the bonding-curve history in the
  // opposite visual direction, so reverse only the plotted
  // point order on mobile. Desktop remains unchanged.
  const isMobile =
    typeof window !== "undefined" &&
    window.innerWidth <= 900;

  const renderPoints = isMobile
    ? [...points].reverse()
    : points;

  const prices = renderPoints.map((p) =>
    Number(p.price)
  );

  let minPrice = Math.min(...prices);
  let maxPrice = Math.max(...prices);

  const isDesktop =
    typeof window !== "undefined" &&
    window.innerWidth > 900;

  if (minPrice === maxPrice) {
    const delta =
      Math.abs(minPrice) *
        (isDesktop ? 0.075 : 0.05) ||
      0.000000000001;

    minPrice -= delta;
    maxPrice += delta;
  } else if (isDesktop) {
    // Desktop: keep a wider visual Y-range so a normal SELL
    // does not look like a full-chart crash.
    const dataRange = maxPrice - minPrice;
    const minimumVisualRange =
      Math.abs(prices[prices.length - 1]) * 0.05;

    const visualRange =
      Math.max(dataRange, minimumVisualRange);

    const center =
      (minPrice + maxPrice) / 2;

    minPrice =
      center - visualRange / 2;

    maxPrice =
      center + visualRange / 2;
  } else {
    const range = maxPrice - minPrice;

    minPrice -= range * 0.06;
    maxPrice += range * 0.06;
  }

  // AELVORA history always renders oldest -> newest.
  // Use point index for X so mobile/desktop cannot reverse
  // the direction because of timestamp scaling.
  const coords = renderPoints.map((point, index) => {
    const x =
      padding.left +
      (points.length > 1
        ? (index / (points.length - 1)) * desktopPlotWidth
        : desktopPlotWidth / 2);

    const y =
      padding.top +
      (1 -
        (Number(point.price) - minPrice) /
          (maxPrice - minPrice)) *
        chartHeight;

    return {
      x,
      y,
      price: Number(point.price),
      index,
    };
  });

  const linePath = coords
    .map((point, index) =>
      `${index === 0 ? "M" : "L"} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`
    )
    .join(" ");

  const areaPath =
    coords.length > 1
      ? `${linePath} L ${coords[coords.length - 1].x.toFixed(2)} ${(height - padding.bottom).toFixed(2)} L ${coords[0].x.toFixed(2)} ${(height - padding.bottom).toFixed(2)} Z`
      : "";

  const latestPrice =
    Number(points[points.length - 1]?.price) || 0;

  let bondingCurvePercent = 0;

  try {
    const reserve = BigInt(ethReserve || 0n);
    const target = 3_000_000_000_000_000_000n;

    bondingCurvePercent = Number(
      (reserve * 10000n) / target
    ) / 100;

    bondingCurvePercent = Math.min(
      100,
      Math.max(0, bondingCurvePercent)
    );
  } catch {
    bondingCurvePercent = 0;
  }

  return (
    <div className="aelvora-curve-chart">
      <div className="aelvora-curve-chart-header">
        <div>
          <span>Bonding Curve</span>
          <strong>
            {bondingCurvePercent.toFixed(2)}%
          </strong>
        </div>
      </div>

      <svg
        viewBox={`0 0 ${width} ${height}`}
        width="100%"
        height="100%"
        preserveAspectRatio="none"
        role="img"
        aria-label="AELVORA bonding curve chart"
      >
        <line
          x1={padding.left}
          y1={padding.top}
          x2={padding.left}
          y2={height - padding.bottom}
          stroke="currentColor"
          opacity="0.14"
        />

        <line
          x1={padding.left}
          y1={height - padding.bottom}
          x2={width - padding.right}
          y2={height - padding.bottom}
          stroke="currentColor"
          opacity="0.14"
        />

        {areaPath && (
          <path
            d={areaPath}
            fill="currentColor"
            opacity="0.035"
          />
        )}

        <path
          d={linePath}
          fill="none"
          stroke="currentColor"
          strokeWidth="2.5"
          strokeLinecap="round"
          strokeLinejoin="round"
        />

        {coords.length > 0 && (
          <circle
            cx={coords[coords.length - 1].x}
            cy={coords[coords.length - 1].y}
            r="4"
            fill="currentColor"
          />
        )}

        <text
          x={padding.left - 10}
          y={padding.top + 4}
          textAnchor="end"
          fontSize="11"
          opacity="0.55"
        >
          {maxPrice.toLocaleString("en-US", {
            maximumFractionDigits: 8,
          })}
        </text>

        <text
          x={padding.left - 10}
          y={height - padding.bottom}
          textAnchor="end"
          fontSize="11"
          opacity="0.55"
        >
          {minPrice.toLocaleString("en-US", {
            maximumFractionDigits: 8,
          })}
        </text>
      </svg>
    </div>
  );
}


function Pagination({ page, totalPages, onChange }) {
  if (totalPages <= 1) return null;

  return (
    <div className="swap-pagination">
      <button
        type="button"
        disabled={page === 1}
        onClick={() => onChange(page - 1)}
      >
        ←
      </button>

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((item) => (
        <button
          type="button"
          key={item}
          className={page === item ? "active" : ""}
          onClick={() => onChange(item)}
        >
          {item}
        </button>
      ))}

      <button
        type="button"
        disabled={page === totalPages}
        onClick={() => onChange(page + 1)}
      >
        →
      </button>
    </div>
  );
}

