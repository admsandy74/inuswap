          );

          if (!cancelled) {
            const currentPrice = Number(
              tokenData.price || 0
            );

            const historical = Array.isArray(points)
              ? points
              : [];

            /*
             * Add the current resolver price as a
             * temporary live point when available.
             *
             * This stays only in React memory.
             */
            const withCurrent =
              Number.isFinite(currentPrice) &&
              currentPrice > 0
                ? [
                    ...historical,
                    {
                      type: "LIVE",
                      timestamp: Math.floor(
                        Date.now() / 1000
                      ),
                      price: currentPrice,
                    },
                  ]
                : historical;

            const deduped = [];
            const seen = new Set();

            for (const item of withCurrent) {
              const timestamp = Number(
                item?.timestamp
              );

              const price = Number(
                item?.price
              );

              if (
                !Number.isFinite(timestamp) ||
                !Number.isFinite(price) ||
                price <= 0
              ) {
                continue;
              }

              const key =
                `${timestamp}:${price}`;

              if (seen.has(key)) {
                continue;
              }

              seen.add(key);

              deduped.push({
                type:
                  item?.type || "MARKET",
                timestamp,
                price,
              });
            }

            deduped.sort(
              (a, b) =>
                Number(a.timestamp) -
                Number(b.timestamp)
            );

            setChartData(deduped);
          }

          return;
        }

        /*
         * No market pool available.
         * Do not fabricate chart history.
         */
        if (!cancelled) {
          setChartData([]);
        }
      } catch (error) {
        console.error(
          "[AELVORA] Chart load failed:",
          error
        );

        if (!cancelled) {
          setChartData([]);
        }
      } finally {
        if (!cancelled) {
          setChartLoading(false);
        }
      }
    };

    loadChart();

    return () => {
      cancelled = true;
    };
  }, [
    tokenData?.token,
    tokenData?.curve,
    tokenData?.pairAddress,
    tokenData?.isAelvora,
    tokenData?.isGraduated,
    tokenData?.price,
    chartTimeframe,
  ]);


