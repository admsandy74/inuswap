/* =========================================================
   HERO MARKET ORBIT
   ========================================================= */

.hero-visual {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.market-orbit {
  position: relative;
  width: 520px;
  height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* central logo */

.logo-core {
  position: relative;
  width: 190px;
  height: 190px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.hero-logo {
  position: relative;
  width: 150px;
  height: 150px;
  object-fit: contain;
  z-index: 3;
  filter:
    drop-shadow(0 0 12px rgba(0, 211, 149, 0.45))
    drop-shadow(0 0 35px rgba(0, 211, 149, 0.18));
  animation: logoPulse 2.4s ease-in-out infinite;
}

.logo-glow {
  position: absolute;
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(0, 211, 149, 0.18) 0%,
    rgba(0, 211, 149, 0.07) 35%,
    transparent 70%
  );
  animation: coreGlow 2.4s ease-in-out infinite;
}

/* orbit rings */

.orbit-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 1px solid rgba(124, 255, 215, 0.22);
  border-radius: 50%;
  transform-style: preserve-3d;
}

.ring-one {
  transform: rotateX(64deg) rotateZ(18deg);
  animation: orbitOne 6s linear infinite;
}

.ring-two {
  transform: rotateX(64deg) rotateZ(78deg);
  animation: orbitTwo 8s linear infinite reverse;
}

.ring-three {
  transform: rotateX(64deg) rotateZ(138deg);
  animation: orbitThree 10s linear infinite;
}

.ring-one::after,
.ring-two::after,
.ring-three::after {
  content: "";
  position: absolute;
  inset: 12%;
  border: 1px solid rgba(0, 211, 149, 0.08);
  border-radius: 50%;
}

/* orbit particles */

.orbit-particle {
  position: absolute;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #7cffd7;
  box-shadow:
    0 0 10px rgba(124, 255, 215, 0.9),
    0 0 28px rgba(0, 211, 149, 0.55);
}

.particle-one {
  top: -6px;
  left: 50%;
}

.particle-two {
  right: -6px;
  top: 50%;
}

.particle-three {
  bottom: -6px;
  left: 50%;
}

/* subtle rotating inner circle */

.logo-core::before {
  content: "";
  position: absolute;
  width: 225px;
  height: 225px;
  border: 1px solid rgba(124, 255, 215, 0.14);
  border-radius: 50%;
  animation: innerRotate 5s linear infinite;
}

/* animation */

@keyframes orbitOne {
  from {
    transform: rotateX(64deg) rotateZ(18deg);
  }

  to {
    transform: rotateX(64deg) rotateZ(378deg);
  }
}

@keyframes orbitTwo {
  from {
    transform: rotateX(64deg) rotateZ(78deg);
  }

  to {
    transform: rotateX(64deg) rotateZ(-282deg);
  }
}

@keyframes orbitThree {
  from {
    transform: rotateX(64deg) rotateZ(138deg);
  }

  to {
    transform: rotateX(64deg) rotateZ(498deg);
  }
}

@keyframes innerRotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes logoPulse {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.045);
  }
}

@keyframes coreGlow {
  0%,
  100% {
    opacity: 0.65;
    transform: scale(0.95);
  }

  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

/* visual label */

.visual-label {
  position: absolute;
  right: 10px;
  bottom: 28px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-align: right;
}

.visual-label span {
  font-size: 10px;
  letter-spacing: 0.18em;
  color: rgba(199, 216, 208, 0.55);
}

.visual-label strong {
  font-size: 12px;
  letter-spacing: 0.16em;
  color: #7cffd7;
}

/* mobile */

@media (max-width: 900px) {
  .hero-visual {
    min-height: 430px;
  }

  .market-orbit {
    width: 390px;
    height: 390px;
  }

  .logo-core {
    width: 150px;
    height: 150px;
  }

  .hero-logo {
    width: 120px;
    height: 120px;
  }

  .logo-glow {
    width: 150px;
    height: 150px;
  }

  .logo-core::before {
    width: 180px;
    height: 180px;
  }

  .visual-label {
    right: 15px;
    bottom: 10px;
  }
}

@media (max-width: 600px) {
  .hero-visual {
    min-height: 350px;
  }

  .market-orbit {
    width: 300px;
    height: 300px;
  }

  .hero-logo {
    width: 95px;
    height: 95px;
  }

  .logo-core {
    width: 120px;
    height: 120px;
  }

  .logo-glow {
    width: 125px;
    height: 125px;
  }

  .logo-core::before {
    width: 145px;
    height: 145px;
  }

  .orbit-particle {
    width: 9px;
    height: 9px;
  }
}
