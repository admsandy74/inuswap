pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

interface IAelvoraCreatorFeeVault {
    function accrueCreatorFee(
        address token,
        address creator
    ) external payable;
}

contract AelvoraBondingCurve is ReentrancyGuard {
    uint256 public constant GRADUATION_TARGET = 3 ether;
    uint256 public constant PLATFORM_FEE_BPS = 100;
    uint256 public constant BPS = 10_000;

    IERC20 public immutable token;
    address public immutable factory;
    address public immutable creator;
    address public immutable tradingFeeRecipient;
    address public immutable creatorFeeVault;

    uint256 public immutable creatorTaxBps;

    uint256 public ethReserve;
    uint256 public tokenReserve;

    uint256 public totalVolumeEth;
    uint256 public totalBuyVolumeEth;
    uint256 public totalSellVolumeEth;

    bool public graduated;

    error OnlyFactory();
    error ZeroAddress();
    error InvalidCreatorTax();
    error InvalidAmount();
    error InsufficientTokenLiquidity();
    error InsufficientEthLiquidity();
    error GraduationReached();
    error AlreadyGraduated();
    error TransferFailed();
    error VaultAccrualFailed();

    event Bought(
        address indexed buyer,
        uint256 ethGross,
        uint256 platformFee,
        uint256 creatorFee,
        uint256 ethToCurve,
        uint256 tokensOut
    );

    event Sold(
        address indexed seller,
        uint256 tokensIn,
        uint256 ethGross,
        uint256 platformFee,
        uint256 creatorFee,
        uint256 ethToSeller
    );

    event Graduated(
        uint256 ethReserve,
        uint256 tokenReserve
    );

    constructor(
        address token_,
        address creator_,
        address tradingFeeRecipient_,
        address creatorFeeVault_,
        uint256 creatorTaxBps_
    ) {
        if (
            token_ == address(0) ||
            creator_ == address(0) ||
            tradingFeeRecipient_ == address(0) ||
            creatorFeeVault_ == address(0)
        ) {
            revert ZeroAddress();
        }

        if (creatorTaxBps_ > 500) {
            revert InvalidCreatorTax();
        }

        token = IERC20(token_);
        factory = msg.sender;
        creator = creator_;
        tradingFeeRecipient = tradingFeeRecipient_;
        creatorFeeVault = creatorFeeVault_;
        creatorTaxBps = creatorTaxBps_;
    }

    modifier onlyFactory() {
        if (msg.sender != factory) revert OnlyFactory();
        _;
    }

    function initializeLiquidity(
        uint256 tokenAmount
    ) external onlyFactory {
        if (tokenReserve != 0 || ethReserve != 0) {
            revert AlreadyGraduated();
        }

        if (tokenAmount == 0) {
            revert InvalidAmount();
        }

        if (!token.transferFrom(factory, address(this), tokenAmount)) {
            revert TransferFailed();
        }

        tokenReserve = tokenAmount;
    }

    function buy()
        external
        payable
        nonReentrant
        returns (uint256 tokensOut)
    {
        if (graduated) revert GraduationReached();
        if (msg.value == 0) revert InvalidAmount();

        uint256 platformFee =
            (msg.value * PLATFORM_FEE_BPS) / BPS;

        uint256 creatorFee =
            (msg.value * creatorTaxBps) / BPS;

        uint256 ethToCurve =
            msg.value - platformFee - creatorFee;

        if (ethToCurve == 0) revert InvalidAmount();

        _sendETH(tradingFeeRecipient, platformFee);

        if (creatorFee > 0) {
            IAelvoraCreatorFeeVault(creatorFeeVault)
                .accrueCreatorFee{value: creatorFee}(
                    address(token),
                    creator
                );
        }

        tokensOut = _quoteBuy(ethToCurve);

        if (tokensOut == 0 || tokensOut >= tokenReserve) {
            revert InsufficientTokenLiquidity();
        }

        tokenReserve -= tokensOut;
        ethReserve += ethToCurve;

        totalVolumeEth += ethToCurve;
        totalBuyVolumeEth += ethToCurve;

        if (ethReserve >= GRADUATION_TARGET) {
            graduated = true;

            emit Graduated(
                ethReserve,
                tokenReserve
            );
        }

        if (!token.transfer(msg.sender, tokensOut)) {
            revert TransferFailed();
        }

        emit Bought(
            msg.sender,
            msg.value,
            platformFee,
            creatorFee,
            ethToCurve,
            tokensOut
        );
    }

    function sell(
        uint256 tokenAmount
    )
        external
        nonReentrant
        returns (uint256 ethToSeller)
    {
        if (tokenAmount == 0) revert InvalidAmount();

        if (tokenAmount >= tokenReserve) {
            revert InsufficientTokenLiquidity();
        }

        uint256 ethGross = _quoteSell(tokenAmount);

        if (ethGross == 0 || ethGross > ethReserve) {
            revert InsufficientEthLiquidity();
        }

        uint256 platformFee =
            (ethGross * PLATFORM_FEE_BPS) / BPS;

        uint256 creatorFee =
            (ethGross * creatorTaxBps) / BPS;

        ethToSeller =
            ethGross - platformFee - creatorFee;

        if (ethToSeller == 0) revert InvalidAmount();

        if (!token.transferFrom(
            msg.sender,
            address(this),
            tokenAmount
        )) {
            revert TransferFailed();
        }

        ethReserve -= ethGross;
        tokenReserve += tokenAmount;

        totalVolumeEth += ethGross;
        totalSellVolumeEth += ethGross;

        _sendETH(
            tradingFeeRecipient,
            platformFee
        );

        if (creatorFee > 0) {
            IAelvoraCreatorFeeVault(creatorFeeVault)
                .accrueCreatorFee{value: creatorFee}(
                    address(token),
                    creator
                );
        }

        _sendETH(msg.sender, ethToSeller);

        emit Sold(
            msg.sender,
            tokenAmount,
            ethGross,
            platformFee,
            creatorFee,
            ethToSeller
        );
    }

    function quoteBuy(
        uint256 ethGross
    )
        external
        view
        returns (
            uint256 tokensOut,
            uint256 platformFee,
            uint256 creatorFee,
            uint256 ethToCurve
        )
    {
        platformFee =
            (ethGross * PLATFORM_FEE_BPS) / BPS;

        creatorFee =
            (ethGross * creatorTaxBps) / BPS;

        ethToCurve =
            ethGross - platformFee - creatorFee;

        if (ethToCurve > 0) {
            tokensOut = _quoteBuy(ethToCurve);
        }
    }

    function quoteSell(
        uint256 tokenAmount
    )
        external
        view
        returns (
            uint256 ethGross,
            uint256 platformFee,
            uint256 creatorFee,
            uint256 ethToSeller
        )
    {
        ethGross = _quoteSell(tokenAmount);

        platformFee =
            (ethGross * PLATFORM_FEE_BPS) / BPS;

        creatorFee =
            (ethGross * creatorTaxBps) / BPS;

        ethToSeller =
            ethGross - platformFee - creatorFee;
    }

    function priceData()
        external
        view
        returns (
            uint256 currentEthReserve,
            uint256 currentTokenReserve,
            uint256 volumeEth,
            bool isGraduated
        )
    {
        return (
            ethReserve,
            tokenReserve,
            totalVolumeEth,
            graduated
        );
    }

    function _quoteBuy(
        uint256 ethIn
    )
        internal
        view
        returns (uint256)
    {
        if (
            ethReserve == 0 ||
            tokenReserve == 0
        ) {
            return 0;
        }

        uint256 k =
            ethReserve * tokenReserve;

        uint256 newEthReserve =
            ethReserve + ethIn;

        uint256 newTokenReserve =
            k / newEthReserve;

        return tokenReserve - newTokenReserve;
    }

    function _quoteSell(
        uint256 tokenIn
    )
        internal
        view
        returns (uint256)
    {
        if (
            ethReserve == 0 ||
            tokenReserve == 0 ||
            tokenIn >= tokenReserve
        ) {
            return 0;
        }

        uint256 k =
            ethReserve * tokenReserve;

        uint256 newTokenReserve =
            tokenReserve + tokenIn;

        uint256 newEthReserve =
            k / newTokenReserve;

        return ethReserve - newEthReserve;
    }

    function _sendETH(
        address recipient,
        uint256 amount
    ) internal {
        if (amount == 0) return;

        (bool success, ) =
            payable(recipient).call{
                value: amount
            }("");

        if (!success) {
            revert TransferFailed();
        }
    }

    receive() external payable {}
}
