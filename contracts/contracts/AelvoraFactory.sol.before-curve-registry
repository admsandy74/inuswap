pragma solidity ^0.8.24;

import "./AelvoraToken.sol";

contract AelvoraFactory {
    uint256 public constant LAUNCH_FEE = 0.0003 ether;
    uint256 public constant MAX_TOTAL_SUPPLY = 1_000_000_000_000;
    uint256 public constant MAX_CREATOR_TAX_BPS = 500;

    address public immutable launchFeeRecipient;
    address public immutable tradingFeeRecipient;
    address public immutable creatorFeeVault;

    address[] public allTokens;

    struct TokenInfo {
        address token;
        address creator;
        uint256 totalSupply;
        uint256 creatorTaxBps;
        uint256 createdAt;
    }

    mapping(address => TokenInfo) public tokenInfo;

    error IncorrectLaunchFee();
    error InvalidSupply();
    error InvalidCreatorTax();
    error ZeroAddress();

    event TokenCreated(
        address indexed token,
        address indexed creator,
        string name,
        string symbol,
        uint256 totalSupply,
        uint256 creatorTaxBps
    );

    constructor(
        address launchFeeRecipient_,
        address tradingFeeRecipient_,
        address creatorFeeVault_
    ) {
        if (
            launchFeeRecipient_ == address(0) ||
            tradingFeeRecipient_ == address(0) ||
            creatorFeeVault_ == address(0)
        ) {
            revert ZeroAddress();
        }

        launchFeeRecipient = launchFeeRecipient_;
        tradingFeeRecipient = tradingFeeRecipient_;
        creatorFeeVault = creatorFeeVault_;
    }

    function createToken(
        string calldata name_,
        string calldata symbol_,
        uint256 totalSupply_,
        uint256 creatorTaxBps_
    ) external payable returns (address tokenAddress) {
        if (msg.value != LAUNCH_FEE) {
            revert IncorrectLaunchFee();
        }

        if (
            totalSupply_ == 0 ||
            totalSupply_ > MAX_TOTAL_SUPPLY
        ) {
            revert InvalidSupply();
        }

        if (creatorTaxBps_ > MAX_CREATOR_TAX_BPS) {
            revert InvalidCreatorTax();
        }

        AelvoraToken token = new AelvoraToken(
            name_,
            symbol_,
            totalSupply_,
            creatorTaxBps_,
            msg.sender,
            tradingFeeRecipient,
            creatorFeeVault
        );

        tokenAddress = address(token);

        allTokens.push(tokenAddress);

        tokenInfo[tokenAddress] = TokenInfo({
            token: tokenAddress,
            creator: msg.sender,
            totalSupply: totalSupply_,
            creatorTaxBps: creatorTaxBps_,
            createdAt: block.timestamp
        });

        (bool sent, ) = payable(launchFeeRecipient).call{
            value: msg.value
        }("");

        require(sent, "Launch fee transfer failed");

        emit TokenCreated(
            tokenAddress,
            msg.sender,
            name_,
            symbol_,
            totalSupply_,
            creatorTaxBps_
        );
    }

    function tokenCount() external view returns (uint256) {
        return allTokens.length;
    }
}
