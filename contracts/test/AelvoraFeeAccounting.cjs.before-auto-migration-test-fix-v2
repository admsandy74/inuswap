    expect(graduationReserve).to.equal(
      (totalSupply * 2500n) / 10000n
    );
  });


  it("GRADUATION allows final buy to overshoot 3 ETH target", async function () {
    const tokenData = await createToken(
      creatorA,
      "Graduation Overshoot Token",
      "GOV"
    );

    const curve = await ethers.getContractAt(
      "AelvoraBondingCurve",
      tokenData.curve
    );

    // Mandatory first-buy already contributed:
    // 0.001 ETH gross
    // - 1% platform fee
    // - 2% creator tax
    // = 0.00097 ETH real curve reserve.
    const initialReserve =
      await curve.ethReserve();

    expect(initialReserve).to.equal(
      ethers.parseEther("0.00097")
    );

    expect(await curve.graduated()).to.equal(false);

    /*
     * Buy enough ETH so the curve crosses the
     * 3 ETH graduation threshold.
     *
     * IMPORTANT:
     * The final transaction is NOT required to land
     * exactly at 3 ETH.
     *
     * If the transaction takes the reserve from:
     *
     *   2.9 ETH -> 3.2 ETH
     *
     * it must still succeed.
     */
    const buyEth = ethers.parseEther("3.2");

    const quote = await curve.quoteBuy(buyEth);

    expect(quote.tokensOut).to.be.gt(0);

    await curve
      .connect(creatorB)
      .buy({
        value: buyEth,
      });

    const finalReserve =
      await curve.ethReserve();

    /*
     * Graduation must happen once the real curve
     * ETH reserve reaches/exceeds 3 ETH.
     */
    expect(finalReserve).to.be.gte(
      ethers.parseEther("3")
    );

    expect(await curve.graduated()).to.equal(true);

    /*
     * Most important assertion:
     *
     * The final buy was NOT reverted merely because
     * it pushed the reserve above 3 ETH.
     */
    expect(finalReserve).to.be.gt(
      ethers.parseEther("3")
    );
  });


  it("MIGRATION freezes curve and snapshots actual overshoot assets", async function () {
    const tokenData = await createToken(
      creatorA,
      "Migration Test Token",
      "MIG"
    );

    const curve = await ethers.getContractAt(
      "AelvoraBondingCurve",
      tokenData.curve
    );

    // Final buy deliberately overshoots the 3 ETH target.
    await curve
      .connect(creatorB)
      .buy({
        value: ethers.parseEther("3.2"),
      });

    expect(await curve.graduated()).to.equal(true);
    expect(await curve.migrationStarted()).to.equal(false);
    expect(await curve.migrationCompleted()).to.equal(false);

    const actualEthReserve =
      await curve.ethReserve();

    const actualTokenReserve =
      await curve.tokenReserve();

    const graduationReserve =
      await curve.graduationTokenReserve();

    const expectedMigrationTokens =
      actualTokenReserve +
      graduationReserve;

    expect(actualEthReserve).to.be.gt(
      ethers.parseEther("3")
    );

    /*
     * Factory starts migration.
     */
    await factory
      .connect(owner)
      .getAddress();

    await curve
      .connect(owner)
      .startMigration();

    expect(await curve.migrationStarted()).to.equal(true);

      // Migration snapshots the ACTUAL reserves.
      // ETH is not capped at the 3 ETH graduation target.
      // Tokens are active curve inventory + untouched
      // graduation reserve.
      expect(
        await curve.migrationEthAmount()
      ).to.equal(
        actualEthReserve
      );

      expect(
        await curve.migrationTokenAmount()
      ).to.equal(
        expectedMigrationTokens
      );

    /*
     * Once migration starts, bonding curve trading stops.
     */
    await expect(
      curve
        .connect(creatorB)
        .buy({
          value: ethers.parseEther("0.01"),
        })
    ).to.be.revertedWithCustomError(
      curve,
      "GraduationReached"
    );

    /*
     * Migration cannot be started twice.
     */
    await expect(
      curve.connect(owner).startMigration()
    ).to.be.revertedWithCustomError(
      curve,
      "MigrationAlreadyStarted"
    );

    /*
     * Migration cannot be marked complete twice.
     * First completion is allowed at lifecycle level.
     */
    await curve
      .connect(owner)
      .completeMigration();

    expect(await curve.migrationCompleted()).to.equal(true);

    await expect(
      curve.connect(owner).completeMigration()
    ).to.be.revertedWithCustomError(
      curve,
      "MigrationAlreadyCompleted"
    );
  });

  it("SELL sends creator tax to CreatorFeeVault", async function () {
    const tokenData = await createToken(
      creatorA,
      "Sell Fee Token",
      "SFT",
      200
    );

    const curve = await ethers.getContractAt(
      "AelvoraBondingCurve",
      tokenData.curve
    );

    const buyAmount = ethers.parseEther("0.01");

    await curve
      .connect(creatorB)
      .buy({ value: buyAmount });

    const tokenContract = await ethers.getContractAt(
      "AelvoraToken",
      tokenData.token
    );

    const tokenBalance = await tokenContract.balanceOf(
      creatorB.address
    );

    const sellAmount = tokenBalance / 2n;

    const quote = await curve.quoteSell(sellAmount);

    const before = await vault.claimable(
      tokenData.token,
      creatorA.address
    );

    await tokenContract
      .connect(creatorB)
      .approve(tokenData.curve, sellAmount);

    await curve
      .connect(creatorB)
      .sell(sellAmount);

    const after = await vault.claimable(
      tokenData.token,
      creatorA.address
    );

    expect(after - before).to.equal(
      quote.creatorFee
    );
  });});
